rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to create their own profile on first signup
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth.uid == userId && 
                       !('role' in request.resource.data.diff(resource.data)) &&
                       !('trustScore' in request.resource.data.diff(resource.data)) &&
                       !('totalReportsMade' in request.resource.data.diff(resource.data));
      allow delete: if false;

      // FCM tokens subcollection
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Public profile (read-only)
      match /public/{doc} {
        allow read: if true;
        allow write: if request.auth.uid == userId;
      }
    }

    // Peer locations for real-time sharing
    match /peer_locations/{userId} {
      allow read: if true;
      allow write: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }

    // Bus tracking and reports
    match /bus_tracking/{trackingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bus_reports/{reportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bus_data/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
